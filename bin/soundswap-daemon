#!/usr/bin/env bash
# Watch session event streams. Each watcher owns a process group, so stopping
# this service cannot signal another process in the caller's group.
base="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
common="$base/../share/common.sh"
[[ -f $common ]] || common="${XDG_DATA_HOME:-$HOME/.local/share}/soundswap/common.sh"
# shellcheck source=share/common.sh
source "$common" || exit 1
runtime_dir || { echo 'Cannot create private sound runtime directory' >&2; exit 1; }
player="$base/soundswap-play"
[[ -x $player ]] || player="$HOME/.local/bin/soundswap-play"
play() { "$player" "$1"; }

quiet() {
  local until=0
  [[ -f $state/quiet-until ]] && read -r until < "$state/quiet-until"
  [[ $until =~ ^[0-9]{1,12}$ ]] && (( $(date +%s) < until ))
}

set_quiet() {
  local tmp
  tmp=$(mktemp "$state/.quiet.XXXXXX") || return 1
  printf '%s\n' "$(($(date +%s) + $1))" > "$tmp"
  mv -- "$tmp" "$state/quiet-until"
}

on_ac() {
  local supply type online
  for supply in /sys/class/power_supply/*; do
    [[ -r $supply/type ]] || continue
    read -r type < "$supply/type"
    [[ $type == Mains && -r $supply/online ]] || continue
    read -r online < "$supply/online"
    [[ $online == 1 ]] && return 0
  done
  return 1
}

device_sound() {
  quiet && return 0
  play "$1"
}

watch_lock() {
  journalctl --user -f -n0 -o cat SYSLOG_IDENTIFIER=omarchy-shell |
    while IFS= read -r line; do
      case $line in
        *"omarchy lock "*" secure=true"*) play lock ;;
        *"omarchy lock "*" unlocked"*) play unlock ;;
      esac
    done
}

watch_notifications() {
  dbus-monitor --session "type='method_call',interface='org.freedesktop.Notifications',member='Notify'" 2>/dev/null |
    awk '
      /member=Notify$/ { inmsg=1; strings=0; replaces=0; urgency=1; summary=""; want_urgency=0; next }
      !inmsg { next }
      /^   uint32 / { replaces=$2 }
      /^   string / {
        strings++
        if (strings == 3) { summary=$0; sub(/^   string "/, "", summary); sub(/"$/, "", summary) }
      }
      /string "urgency"/ { want_urgency=1; next }
      want_urgency && /variant/ { urgency=$NF; want_urgency=0 }
      /^   int32 / { printf "%s\t%s\t%s\n", replaces, urgency, summary; fflush(); inmsg=0; want_urgency=0 }
    ' |
    while IFS=$'\t' read -r replaces urgency summary; do
      [[ $replaces == 0 ]] || continue
      case $summary in
        "Screenshot saved"*) play screenshot; continue ;;
        "Time to recharge!") continue ;;
      esac
      if [[ $urgency == 2 ]]; then
        play notification-critical
      elif [[ $(timeout 2s omarchy-shell notifications isDnd 2>/dev/null) == off ]]; then
        play notification
      fi
    done
}

watch_usb() {
  udevadm monitor --udev --subsystem-match=usb/usb_device |
    while read -r _ _ action _; do
      case $action in
        add) device_sound device-connect ;;
        remove) device_sound device-disconnect ;;
      esac
    done
}

watch_bluetooth() {
  gdbus monitor --system --dest org.bluez |
    while IFS= read -r line; do
      [[ $line == *"'org.bluez.Device1'"* ]] || continue
      case $line in
        *"'Connected': <true>"*) device_sound device-connect ;;
        *"'Connected': <false>"*) device_sound device-disconnect ;;
      esac
    done
}

watch_power() {
  local critical_sent=0 level threshold on_battery=unknown
  local percentage_re="'Percentage': <([^>]+)>"
  gdbus monitor --system --dest org.freedesktop.UPower |
    while IFS= read -r line; do
      case $line in
        *"'OnBattery': <false>"*) on_battery=0; play charger-connect; critical_sent=0 ;;
        *"'OnBattery': <true>"*) on_battery=1; play charger-disconnect ;;
      esac
      if [[ $line == /org/freedesktop/UPower/devices/DisplayDevice:* && $line =~ $percentage_re ]]; then
        level=${BASH_REMATCH[1]}
        [[ $level =~ ^(0|[1-9][0-9]?|100)(\.[0-9]+)?$ ]] || continue
        read_config
        threshold=$CRITICAL_BATTERY_LEVEL
        if awk -v level="$level" -v threshold="$threshold" 'BEGIN {exit !(level <= threshold)}' &&
          (( ! critical_sent )) && { [[ $on_battery == 1 ]] || { [[ $on_battery == unknown ]] && ! on_ac; }; }; then
          play battery-critical; critical_sent=1
        elif awk -v level="$level" -v threshold="$threshold" 'BEGIN {exit !(level > threshold + 2)}'; then
          critical_sent=0
        fi
      fi
    done
}

watch_sleep() {
  gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1 |
    while IFS= read -r line; do
      case $line in
        *"PrepareForSleep (true"*) set_quiet 3600 ;;
        *"PrepareForSleep (false"*) set_quiet 8 ;;
      esac
    done
}

# Sourcing this file permits isolated stream tests without starting the service.
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0

watchers=(lock notifications usb bluetooth power sleep)
if [[ ${1:-} == --watch ]]; then
  name=${2:-}
  [[ " ${watchers[*]} " == *" $name "* ]] || { echo "Unknown watcher: $name" >&2; exit 2; }
  group=$(ps -o pgid= -p $$) || exit 1
  [[ ${group//[[:space:]]/} == "$$" ]] || { echo 'Watcher must run in an isolated process group' >&2; exit 2; }
  "watch_$name"
  exit 1  # An event stream ending is always a failure and should be retried.
fi
[[ $# == 0 ]] || { echo 'Usage: soundswap-daemon' >&2; exit 2; }
exec 9>"$state/daemon.lock" || exit 1
flock -n 9 || { echo 'SoundSwap watcher is already running' >&2; exit 1; }

declare -A pids=() warned=()
start_watcher() {
  local name=$1
  setsid "$0" --watch "$name" 9>&- &
  pids[$name]=$!
}
cleanup() {
  local name pid
  trap - EXIT
  for name in "${watchers[@]}"; do
    pid=${pids[$name]:-}
    [[ -n $pid ]] && kill -TERM -- "-$pid" 2>/dev/null || :
  done
  wait 2>/dev/null || :
}
trap cleanup EXIT
trap 'exit 0' TERM INT
for name in "${watchers[@]}"; do start_watcher "$name"; done
while :; do
  ended=
  wait -n -p ended "${pids[@]}" 2>/dev/null || :
  [[ -n $ended ]] || exit 1
  for name in "${watchers[@]}"; do
    [[ ${pids[$name]} == "$ended" ]] || continue
    # The leader may have died while its pipeline children kept running.
    # Their isolated process group still has the leader's PID as its PGID.
    kill -TERM -- "-$ended" 2>/dev/null || :
    if [[ -z ${warned[$name]:-} ]]; then
      echo "Watcher $name ended; retrying" >&2
      warned[$name]=1
    fi
    sleep 2
    start_watcher "$name"
    break
  done
done
