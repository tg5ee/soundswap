#!/usr/bin/env bash
# soundswap — control SoundSwap sounds.

# Prefer the checkout helper when running from source.
base="$(dirname "$(readlink -f "$0")")"
common="$base/../share/common.sh"
[[ -f $common ]] || common="${XDG_DATA_HOME:-$HOME/.local/share}/soundswap/common.sh"
# shellcheck source=share/common.sh
source "$common" || exit 1
player="$base/soundswap-play"

usage() {
  cat <<USAGE
Usage: soundswap <command>

  status               Show settings and which sound files are present
  events               List every event and what triggers it
  on | off | toggle    Turn all sounds on/off
  enable EVENT         Turn one event on
  disable EVENT        Turn one event off
  volume 0.0-1.0       Set playback volume
  event-volume EVENT N Set event gain (0.0-1.0), multiplied by master volume
  test [EVENT]         Play one event, or all of them in turn
  preview EVENT        Play one event even if it's switched off
  poweroff | reboot | logout  Play shutdown before Omarchy's lifecycle action
  dir                  Print the sounds folder
  log [on|off]         Record every trigger; with no argument, watch the log
  json                 Print settings as JSON (used by the bar panel)
  doctor               Check SoundSwap runtime dependencies and integrations
USAGE
}

doctor() {
  local failed=0 tool player='' config_root=${XDG_CONFIG_HOME:-$HOME/.config}
  local plugin_dir="$config_root/omarchy/plugins/soundswap.sounds"
  local shell_config="$config_root/omarchy/shell.json"
  local menu="$config_root/omarchy/extensions/omarchy-menu.jsonc"
  local hypr_dir="$config_root/hypr" main="$config_root/hypr/hyprland.lua"
  local unit_dir="$config_root/systemd/user" unit plugins
  local required_tools=(flock setsid timeout systemctl journalctl dbus-monitor gdbus udevadm awk cp mv mkdir mktemp stat date sleep ps rm tail readlink dirname grep chmod touch)
  local -a missing_tools=()

  report() {
    local level=$1 message=$2
    printf '%s: %s\n' "$level" "$message"
    if [[ $level == FAIL ]]; then failed=1; fi
    return 0
  }

  for tool in "${required_tools[@]}"; do
    command -v "$tool" >/dev/null 2>&1 || missing_tools+=("$tool")
  done
  if ((${#missing_tools[@]})); then
    for tool in "${missing_tools[@]}"; do
      report FAIL "required command missing: $tool. Find its package with: pacman -F $tool"
    done
  else
    report PASS 'required runtime commands are available'
  fi
  for tool in pw-play paplay mpv; do
    if command -v "$tool" >/dev/null 2>&1; then player=$tool; break; fi
  done
  if [[ -n $player ]]; then
    report PASS "audio playback command available: $player"
  else
    report WARN 'no audio player found (pw-play, paplay, or mpv); install PipeWire, PulseAudio, or mpv to play sounds'
  fi
  for lifecycle in shutdown reboot logout; do
    local action="omarchy-system-$lifecycle"
    if command -v "$action" >/dev/null 2>&1; then
      report PASS "Omarchy lifecycle command is available: $action"
    else
      report WARN "$action is unavailable; its SoundSwap menu action cannot invoke Omarchy's original action. Check your Omarchy installation and restore the helper"
    fi
  done
  if [[ -n ${XDG_RUNTIME_DIR:-} && -d $XDG_RUNTIME_DIR && -w $XDG_RUNTIME_DIR ]]; then
    report PASS 'writable desktop runtime directory is available'
  else
    report FAIL 'writable XDG_RUNTIME_DIR is unavailable. Run from an active Omarchy desktop session'
  fi

  for tool in manifest.json Panel.qml soundswap.svg; do
    if [[ -f $plugin_dir/$tool && -r $plugin_dir/$tool ]]; then
      report PASS "plugin file available: $tool"
    else
      report FAIL "plugin file missing: $tool. Reinstall SoundSwap with ./install.sh"
    fi
  done
  if [[ -r $plugin_dir/manifest.json ]] &&
      grep -Fq '"id": "soundswap.sounds"' "$plugin_dir/manifest.json" &&
      grep -Fq '"bar-widget"' "$plugin_dir/manifest.json" &&
      grep -Fq '"barWidget": "Panel.qml"' "$plugin_dir/manifest.json"; then
    report PASS 'plugin manifest identifies the SoundSwap bar widget'
  else
    report FAIL "plugin manifest is invalid or incomplete: $plugin_dir/manifest.json. Reinstall SoundSwap with ./install.sh"
  fi
  if [[ -r $shell_config ]] && grep -Eq '"id"[[:space:]]*:[[:space:]]*"soundswap.sounds"' "$shell_config"; then
    report PASS 'bar layout registers soundswap.sounds'
  else
    report FAIL "bar widget is not registered in $shell_config. Enable it with: omarchy plugin enable soundswap.sounds"
  fi
  if command -v omarchy-shell >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
    if plugins=$(timeout 5 omarchy-shell shell listPlugins 2>/dev/null); then
      if grep -Eq '"id"[[:space:]]*:[[:space:]]*"soundswap.sounds"[^}]*"enabled"[[:space:]]*:[[:space:]]*true' <<< "$plugins"; then
        report PASS 'Omarchy plugin registry reports the SoundSwap widget enabled'
      elif grep -Eq '"id"[[:space:]]*:[[:space:]]*"soundswap.sounds"' <<< "$plugins"; then
        report FAIL 'bar widget is disabled in the Omarchy plugin registry. Enable it with: omarchy plugin enable soundswap.sounds'
      else
        report FAIL 'SoundSwap is missing from the Omarchy plugin registry. Reinstall with ./install.sh, then enable soundswap.sounds'
      fi
    else
      report WARN 'could not query the Omarchy plugin registry. Run soundswap doctor from an active Omarchy session'
    fi
  else
    report WARN 'omarchy-shell is unavailable; cannot confirm plugin registration state. Run from Omarchy with omarchy-shell on PATH'
  fi

  if [[ -r $main ]] && grep -Fq '"/hypr/soundswap.lua")' "$main" && [[ -r $hypr_dir/soundswap.lua ]]; then
    report PASS 'Hyprland config loads the SoundSwap module'
  else
    report FAIL "Hyprland loader or module is missing. Restore the SoundSwap loader in $main or reinstall with ./install.sh"
  fi

  local menu_begin='  // soundswap shutdown >>>' menu_end='  // <<< soundswap shutdown'
  local lifecycle key expected result
  for lifecycle in logout reboot shutdown; do
    case $lifecycle in
      logout) key=system.logout; expected='soundswap logout' ;;
      reboot) key=system.reboot; expected='soundswap reboot' ;;
      shutdown) key=system.shutdown; expected='soundswap poweroff' ;;
    esac
    result=missing
    if [[ -r $menu ]]; then
      result=$(awk -v b="$menu_begin" -v e="$menu_end" -v k="\"$key\"" -v a="\"$expected\"" '
        $0 == b { inside=1; blocks++; next }
        $0 == e { inside=0; next }
        inside {
          segment=$0
          if (!entry) {
            position=index(segment,k)
            if (!position) next
            segment=substr(segment,position+length(k))
            if (segment !~ /^[[:space:]]*:/) next
            found=1
            entry=1
            entry_correct=0
          }
          closing=index(segment,"}")
          if (closing) segment=substr(segment,1,closing-1)
          if (segment ~ /"action"[[:space:]]*:[[:space:]]*"[^"]*"/) {
            action=segment
            sub(/^.*"action"[[:space:]]*:[[:space:]]*"/, "", action)
            sub(/".*$/, "", action)
            if (action == substr(a,2,length(a)-2)) entry_correct=1
          }
          if (closing) {
            if (!entry_correct) bad=1
            entry=0
          }
        }
        END {
          if (blocks != 1 || inside || !found) print "missing"
          else if (bad || entry) print "modified"
          else print "ok"
        }
      ' "$menu")
    fi
    if [[ $result == ok ]]; then
      report PASS "shutdown menu action is configured: $key"
    elif [[ $result == modified ]]; then
      report FAIL "$lifecycle menu action is modified; restore \"$key\" to action \"$expected\" in $menu, or rerun ./install.sh"
    else
      report FAIL "$lifecycle menu action is missing; rerun ./install.sh to add \"$key\" with action \"$expected\" in $menu"
    fi
  done

  if command -v timeout >/dev/null 2>&1 && command -v systemctl >/dev/null 2>&1 &&
      timeout 5 systemctl --user show-environment >/dev/null 2>&1; then
    report PASS 'user systemd service manager is reachable'
  else
    report FAIL 'user systemd service manager is unavailable. Run soundswap doctor from an active Omarchy desktop session'
  fi
  for unit in soundswap.service soundswap-shutdown.service; do
    if [[ ! -r $unit_dir/$unit ]]; then
      report FAIL "user service file missing: $unit. Reinstall SoundSwap with ./install.sh"
    elif command -v timeout >/dev/null 2>&1 && command -v systemctl >/dev/null 2>&1 &&
        timeout 5 systemctl --user is-enabled --quiet "$unit"; then
      report PASS "user service enabled: $unit"
    else
      report FAIL "user service is not enabled: $unit. Enable it with: systemctl --user enable $unit"
    fi
  done

  local -a active_audio_services=()
  if command -v timeout >/dev/null 2>&1 && command -v systemctl >/dev/null 2>&1; then
    for unit in pipewire.service pipewire-pulse.service wireplumber.service pulseaudio.service; do
      timeout 5 systemctl --user is-active --quiet "$unit" && active_audio_services+=("$unit")
    done
  fi
  if ((${#active_audio_services[@]})); then
    report PASS "active user audio service(s): ${active_audio_services[*]}"
  else
    report WARN 'no PipeWire or PulseAudio user service is active; check with: systemctl --user status pipewire pipewire-pulse wireplumber'
  fi
  return "$failed"
}

if [[ ${1:-} == doctor && $# == 1 ]]; then
  doctor
  exit $?
fi

read_config

case "${1:-}" in
  status)
    read_config
    echo "Sounds: $([ "$ENABLED" = 1 ] && echo on || echo off)   Volume: $VOLUME"
    echo "Folder: $conf/sounds"
    last=
    for e in "${EVENTS[@]}"; do
      [ "${GROUP[$e]}" != "$last" ] && { last=${GROUP[$e]}; printf '\n  %s\n' "$last"; }
      v=${e^^}; v=${v//-/_}; state=off; [[ ${!v} == 1 ]] && state=on
      sound_file "$e"; name=${file##*/}
      [[ -n $file ]] || name='(no file yet)'
      printf '    %-22s %-4s %s\n' "$e" "$state" "$name"
    done ;;
  events)
    last=
    for e in "${EVENTS[@]}"; do
      [ "${GROUP[$e]}" != "$last" ] && { last=${GROUP[$e]}; printf '\n%s\n' "$last"; }
      printf '  %-22s %s\n' "$e" "${HINT[$e]}"
    done ;;
  on)      setvar ENABLED 1 || exit 1; echo "Sounds on" ;;
  off)     setvar ENABLED 0 || exit 1; echo "Sounds off" ;;
  toggle)  setvar ENABLED toggle || exit 1; read_config; echo "Sounds enabled=$ENABLED" ;;
  enable)  valid_event "${2:-}" || exit 1; v=${2^^}; setvar "${v//-/_}" 1 || exit 1; echo "$2 on" ;;
  disable) valid_event "${2:-}" || exit 1; v=${2^^}; setvar "${v//-/_}" 0 || exit 1; echo "$2 off" ;;
  volume)
    [[ $2 =~ ^(0(\.[0-9]+)?|1(\.0+)?)$ ]] || { echo "Volume must be between 0.0 and 1.0" >&2; exit 1; }
    setvar VOLUME "$2" || exit 1; echo "Volume $2" ;;
  event-volume)
    valid_event "${2:-}" || exit 1
    [[ ${3:-} =~ ^(0(\.[0-9]+)?|1(\.0+)?)$ ]] || { echo 'Event volume must be between 0.0 and 1.0' >&2; exit 1; }
    v=${2^^}; setvar "${v//-/_}_VOLUME" "$3" || exit 1; echo "$2 volume $3" ;;
  test)
    if [ -n "$2" ]; then valid_event "$2" || exit 1; bash "$player" --wait "$2"
    else for e in "${EVENTS[@]}"; do sound_file "$e"; [ -n "$file" ] && { echo "$e"; bash "$player" --wait "$e" || exit; }; done; fi ;;
  preview) valid_event "${2:-}" || exit 1; bash "$player" --wait --force "$2" ;;
  poweroff|reboot|logout)
    lifecycle=$1
    case $lifecycle in
      poweroff) stock_action=omarchy-system-shutdown ;;
      reboot) stock_action=omarchy-system-reboot ;;
      logout) stock_action=omarchy-system-logout ;;
    esac
    if ! runtime_dir; then
      [[ $lifecycle == poweroff ]] && exit 1
      "$stock_action"
      exit $?
    fi
    if [[ $lifecycle == poweroff ]]; then
      exec 9>"$state/poweroff.lock" || exit 1
      flock -n 9 || exit 0
    fi
    sound_file shutdown
    backend=none
    for candidate in pw-play paplay mpv; do
      if command -v "$candidate" >/dev/null; then backend=$candidate; break; fi
    done
    logger -t soundswap "shutdown early-start file=${file:-none} backend=$backend" || true
    timeout --kill-after=1s 24s bash "$player" --wait shutdown &
    playback_pid=$!
    logger -t soundswap "shutdown playback-pid=$playback_pid" || true
    if wait "$playback_pid"; then
      : > "$state/shutdown.preplayed"
      logger -t soundswap 'shutdown early-complete status=0' || true
    else
      playback_status=$?
      logger -t soundswap "shutdown early-failed status=$playback_status" || true
    fi
    if "$stock_action"; then
      exit 0
    else
      shutdown_status=$?
      rm -f -- "$state/shutdown.preplayed"
      logger -t soundswap "shutdown request-failed status=$shutdown_status" || true
      exit "$shutdown_status"
    fi ;;
  shutdown-stop)
    runtime_dir || exit 1
    if [[ -f $state/shutdown.preplayed ]]; then
      marker_age=$(( $(date +%s) - $(stat -c %Y "$state/shutdown.preplayed") ))
      if (( marker_age >= 0 && marker_age <= 120 )); then
        rm -f -- "$state/shutdown.preplayed"
        echo 'shutdown chime already completed before poweroff'
        exit 0
      fi
      rm -f -- "$state/shutdown.preplayed"
    fi
    bash "$player" --wait shutdown ;;
  dir)     echo "$conf/sounds" ;;
  log)
    runtime_dir || exit 1; log="$state/events.log"
    case "$2" in
      on)  setvar LOG 1 || exit 1; echo "Logging triggers to $log" ;;
      off) setvar LOG 0 || exit 1; echo "Logging off" ;;
      '')  read_config; [ "${LOG:-0}" = 1 ] || echo "Logging is off; turn it on with: soundswap log on"
           mkdir -p "${log%/*}"; touch "$log"; exec tail -f "$log" ;;
      *)   echo "Unknown log option: $2" >&2; exit 2 ;;
    esac ;;
  json)
    enabled=false; [[ $ENABLED == 1 ]] && enabled=true
    printf '{"enabled":%s,"volume":%s,"pack":"SoundSwap Original","dir":' "$enabled" "$VOLUME"
    json_str "$conf/sounds"
    printf ',"events":['
    sep=
    for e in "${EVENTS[@]}"; do
      v=${e^^}; v=${v//-/_}; sound_file "$e"
      enabled=false; [[ ${!v} == 1 ]] && enabled=true
      printf '%s{"id":"%s","label":' "$sep" "$e"
      json_str "${LABEL[$e]}"; printf ',"hint":'; json_str "${HINT[$e]}"
      printf ',"group":'; json_str "${GROUP[$e]}"
      printf ',"icon":"%s","enabled":%s,"file":' "${ICON[$e]}" "$enabled"
      json_str "${file##*/}"
      v=${v}_VOLUME; printf ',"volume":%s}' "${!v}"
      sep=,
    done
    printf ']}\n' ;;
  *)       if [[ $# == 0 ]]; then usage; else usage >&2; exit 2; fi ;;
esac
