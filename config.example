# Working installation preferences; optional, not installed automatically.
# Debug logging was enabled on the source PC; keep it off for normal use.
# Omarchy Sounds settings. Change with `omarchy-sounds` or the bar panel, or edit by hand.
ENABLED=1
VOLUME=0.55

# Play battery-critical at or below this percentage (on battery only)
CRITICAL_BATTERY_LEVEL=5

# Per-event switches (1 = on, 0 = off)
STARTUP=1
SHUTDOWN=1
LOCK=1
UNLOCK=1
AUTH_PROMPT=1
CLICK=0
SUPER=1
VOLUME_KEYS=1
WINDOW_OPEN=1
WINDOW_CLOSE=1
MAXIMIZE=1
RESTORE=1
WORKSPACE=1
ATTENTION=1
MENU_OPEN=1
MENU_CLOSE=1
NOTIFICATION=1
NOTIFICATION_CRITICAL=0
SCREENSHOT=1
DEVICE_CONNECT=1
DEVICE_DISCONNECT=1
CHARGER_CONNECT=1
CHARGER_DISCONNECT=1
BATTERY_LOW=1
BATTERY_CRITICAL=1
THEME_CHANGE=1
UPDATE_COMPLETE=1

# Record every trigger to $XDG_RUNTIME_DIR/omarchy-sounds/events.log (omarchy-sounds log)
LOG=0
